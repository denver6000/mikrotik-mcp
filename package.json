{
  "name": "mikrotik-mcp",
  "version": "0.1.0",
  "description": "A minimal Model Context Protocol (MCP) server that works with any MCP harness (Claude Code, Codex, opencode, ...).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "ai",
    "agent",
    "llm",
    "stdio"
  ],
  "license": "MIT",
  "author": "denver6000",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denver6000/mikrotik-mcp.git"
  },
  "homepage": "https://github.com/denver6000/mikrotik-mcp#readme",
  "bugs": {
    "url": "https://github.com/denver6000/mikrotik-mcp/issues"
  },
  "type": "module",
  "bin": {
    "mikrotik-mcp": "dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "node src/index.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "schema": "node scripts/generate-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "inspect": "npx -y @modelcontextprotocol/inspector node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
